# 复制本文件为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# 必填：DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# 模型名，可选 deepseek-flash（默认，便宜）或 deepseek-v4-pro（更强）
DEEPSEEK_MODEL=deepseek-flash

# 文献调研模式：workflow 保留固定检索；multi_agent 启用两个独立调查 Agent
LITERATURE_MODE=workflow

# 选填：Tavily 搜索 Key（https://tavily.com）。不填则网页搜索退回 DuckDuckGo，国内网络可能不通
TAVILY_API_KEY=

# 向量模型，首次使用会从 HuggingFace 下载约 4.4 GB（权重会以两种格式各下载一份），之后走本地缓存
EMBEDDING_MODEL=BAAI/bge-m3

# 选填：HuggingFace 下载慢时填镜像地址，例如 https://hf-mirror.com
HF_ENDPOINT=

# 选填：数据与输出目录，相对路径以项目根目录为基准
DATA_DIR=data
OUTPUT_DIR=outputs
